{
  "apiUrl": "https://apihub.kma.go.kr/api/typ01/url/sfc_ssn.php",
  "allowInsecureApiUrlForTesting": false,
  "allSeasonsCode": 0,
  "authKeyEnvironmentVariable": "KMA_AUTH_KEY",
  "topicDataFiles": ["data/cherry-blossom.json", "data/autumn-foliage.json", "data/forsythia.json", "data/azalea.json"],
  "outputFile": "data/season-observations.json",
  "requestIntervalMilliseconds": 500,
  "maxRetries": 2,
  "retryWaitMilliseconds": 5000,
  "userAgent": "seasonal-map-updater/0.1",
  "responseEncoding": "euc-kr",
  "responseFormat": {
    "fieldSeparator": ",",
    "observedAtIndex": 2,
    "ssnIdIndex": 3,
    "ssnMdIndex": 4,
    "stationIndex": 1,
    "headerColumns": ["YY", "STN", "TM", "SSN_ID", "SSN_MD"]
  },
  "eventCodes": {
    "개나리/개화": { "ssnId": 203, "ssnMd": 202 },
    "진달래/개화": { "ssnId": 204, "ssnMd": 202 },
    "벚나무/개화": { "ssnId": 205, "ssnMd": 202 },
    "벚나무/만발": { "ssnId": 205, "ssnMd": 203 },
    "유명산 단풍/단풍 시작": { "ssnId": 501, "ssnMd": 501 },
    "유명산 단풍/단풍 절정": { "ssnId": 501, "ssnMd": 503 },
    "은행나무/단풍 시작": { "ssnId": 301, "ssnMd": 301 },
    "은행나무/단풍 절정": { "ssnId": 301, "ssnMd": 302 }
  }
}
